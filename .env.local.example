NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica

# URL pública del sitio (se usa para canonical, sitemap.xml y los datos
# estructurados). En producción debe ser la URL real, por ejemplo
# https://marcareplicas.com
NEXT_PUBLIC_SITE_URL=https://tu-dominio.com

# Número de WhatsApp que recibe los pedidos.
# Formato: código de país + número, SIN el signo +, sin espacios ni guiones.
# Ejemplo Paraguay (0981 234 567): 595981234567
NEXT_PUBLIC_WHATSAPP_NUMBER=595981234567
